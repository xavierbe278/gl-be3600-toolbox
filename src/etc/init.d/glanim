#!/bin/sh /etc/rc.common
# luci-app-glanim - custom screen animation service for GL-BE3600

START=79
STOP=20
USE_PROCD=1

PROG=/usr/bin/glanimd

start_service() {
	local enabled
	config_load glanim
	config_get_bool enabled globals enabled 0
	[ "$enabled" != "1" ] && {
		# Keep OEM gl_screen running while plugin is disabled.
		/etc/init.d/gl_screen start 2>/dev/null
		return 0
	}

	procd_open_instance
	# No respawn: a long-press exit hands the panel back to OEM and must stay
	# stopped instead of being restarted by procd.
	procd_set_param stderr 1
	procd_set_param command "$PROG"
	procd_close_instance
}

stop_service() {
	# Daemon SIGTERM handler restores the OEM gl_screen service.
	true
}

reload_service() {
	stop
	start
}
