{
	"luci-app-glanim": {
		"description": "Grant UCI access for luci-app-glanim",
		"read": {
			"uci": [ "glanim" ],
			"file": {
				"/usr/share/glanim/frames/": [ "read" ],
				"/tmp/glanim.status": [ "read" ]
			}
		},
		"write": {
			"uci": [ "glanim" ],
			"file": {
				"/usr/share/glanim/frames/": [ "write" ]
			}
		}
	}
}
