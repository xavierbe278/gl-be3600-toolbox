#!/bin/sh
# Toggle between the OEM gl_screen and the third-party glanim screen.
# Called by /etc/rc.button/switch: switch ON (pressed) = plugin, OFF (released) = OEM.

action="$1"
case "$action" in
    pressed|on) want=1 ;;
    released|off) want=0 ;;
    *) exit 0 ;;
esac

cur=$(uci -q get glanim.globals.enabled)
logger -t glanim-switch "physical switch $action -> enabled=$want (was $cur)"

if [ "$want" = "1" ]; then
    uci set glanim.globals.enabled='1'
    uci commit glanim
    if ! pidof glanimd >/dev/null 2>&1; then
        /etc/init.d/glanim start >/dev/null 2>&1
    fi
else
    uci set glanim.globals.enabled='0'
    uci commit glanim
    /etc/init.d/glanim stop >/dev/null 2>&1
    /etc/init.d/gl_screen start >/dev/null 2>&1
fi
exit 0
