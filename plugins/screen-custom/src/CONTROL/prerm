#!/bin/sh
[ -n "$IPKG_INSTROOT" ] && exit 0
/etc/init.d/glanim stop 2>/dev/null
# Hand the panel back to the OEM screen service.
/etc/init.d/gl_screen enable 2>/dev/null
/etc/init.d/gl_screen start 2>/dev/null
# Remove the optional gl-ui bridge hooks.
if [ -f /www/gl_home.html ]; then
  sed -i 's#<script src="/luci-static/resources/glui-bridge/glui-bridge.js"></script>##g' /www/gl_home.html
fi
if [ -f /etc/glinjector/core.js ]; then
  sed -i '/GLUI_BRIDGE_LOADER/,$d' /etc/glinjector/core.js
fi
exit 0
