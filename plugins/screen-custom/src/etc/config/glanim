config globals 'globals'
	# Master switch. 0 = OEM gl_screen keeps the original pages.
	option enabled '0'
	# gif      : play the uploaded frame pack as an animation loop
	# still    : hold the first frame on screen
	# slideshow: play frames once per manifest delay (then hold last frame)
	# dashboard: system info panel (clock / CPU / mem / temp / net) with touch
	# custom   : user-defined canvas elements from the custom_layout JSON below
	option mode 'gif'
	option custom_layout ''
	# Optional custom-panel background frame pack (image / GIF / video frames)
	option custom_bg_dir '/usr/share/glanim/custom_bg'
	option custom_bg_frames '0'
	option custom_bg_fps '8'
	option frames_dir '/usr/share/glanim/frames'
	# Force frame interval in fps; 0 = use per-frame delay from manifest
	option fps '0'
	option loop '1'
	# Rotation / mirroring are baked into the pack by the PC tool
	# (glanim-convert.py --orientation); these legacy options are unused.
	option rotate '0'
	option flip '0'
	# Backlight brightness 0..11 (OEM scale 1..10 maps to 1..11)
	option brightness '4'
	# Stop OEM gl_screen while the daemon runs; restore it on exit
	option keep_original '1'

	# ---- dashboard panel items (mode = dashboard) ----
	option show_time '1'
	option show_cpu '1'
	option show_mem '1'
	option show_temp '1'
	option show_net '1'
	option show_uptime '0'
	option show_ip '0'
	# seconds between auto-rotating dashboard pages, 2..30
	option dash_interval '5'

	# ---- touch control (CST816X /dev/input/event0) ----
	option touch_enable '1'
	# next = tap switches page (left third previous, right rest next);
	# wake = only record touch, do not switch pages; none = ignore touch
	option touch_action 'next'
	option touch_swap_xy '0'
	option touch_flip_x '0'
