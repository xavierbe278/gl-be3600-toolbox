#!/bin/sh /etc/rc.common
# FastNet 双版本启动脚本
#   UCI: /etc/config/fastnet  (enabled / version / port / token / logger)
#   版本对应的二进制：/usr/bin/fastnet-<ver> 或 /usr/sbin/FastNet-<ver>

START=99
STOP=10
USE_PROCD=1

fn_binary() {
	_v="$1"
	for _p in /usr/bin/fastnet-"$_v" /usr/sbin/FastNet-"$_v" /usr/bin/FastNet-"$_v" /usr/sbin/fastnet-"$_v"; do
		[ -x "$_p" ] && { echo "$_p"; return 0; }
	done
	return 1
}

fn_fallback() {
	for _p in /usr/bin/fastnet /usr/sbin/FastNet /usr/libexec/fastnet; do
		[ -x "$_p" ] && { echo "$_p"; return 0; }
	done
	return 1
}

start_service() {
	config_load fastnet

	local enabled version port token logger bin
	config_get_bool enabled fastnet enabled 1
	[ "$enabled" = 1 ] || return 0

	config_get version fastnet version ''
	config_get port fastnet port 3200
	config_get token fastnet token ''
	config_get_bool logger fastnet logger 0

	bin=''
	[ -n "$version" ] && bin="$(fn_binary "$version")"
	[ -z "$bin" ] && bin="$(fn_fallback)"
	[ -z "$bin" ] && { logger -t fastnet "no binary found"; return 1; }

	procd_open_instance
	procd_set_param limits nofile="65535 65535"
	procd_set_param command "$bin" web --addr "0.0.0.0:$port" --no-open
	if [ -n "$token" ] && strings "$bin" 2>/dev/null | grep -q -- '--token'; then
		procd_append_param command --token "$token"
	fi
	[ "$logger" = 1 ] && procd_set_param stderr 1
	# FastNet 未设 SO_REUSEADDR，快速重启会撞 TIME_WAIT（约 60s）；
	# 放宽 respawn 次数，让它自己等到端口释放再拉起。
	procd_set_param respawn 3600 5 30
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "fastnet"
}
