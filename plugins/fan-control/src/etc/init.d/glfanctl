#!/bin/sh /etc/rc.common
# luci-app-glfanctl - fan policy service for GL-BE3600

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/glfanctl

start_service() {
	local enabled
	config_load glfanctl
	config_get_bool enabled globals enabled 0
	[ "$enabled" != "1" ] && {
		# Make sure the OEM fan service is running while plugin is disabled.
		/etc/init.d/gl_fan start 2>/dev/null
		return 0
	}

	procd_open_instance
	procd_set_param respawn
	procd_set_param stderr 1
	procd_set_param command "$PROG"
	procd_close_instance
}

stop_service() {
	# Daemon trap (cleanup) restores the OEM gl_fan service on termination.
	true
}

reload_service() {
	stop
	start
}
